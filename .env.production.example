# Production env — copy to .env on the server and fill in real values.
# cp .env.production.example .env

# Ingress/TLS is handled at the infra level (e.g. Cloudflare Tunnel), outside this repo.
# The api is published on 127.0.0.1:8000 (loopback only) — point your tunnel's
# Public Hostname at http://localhost:8000.

# Django
# Generate a key: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
# MUST also include the FE domain: the websocket layer validates the Origin header
# (AllowedHostsOriginValidator), so omitting ghidiem.online breaks viewer sockets.
DJANGO_ALLOWED_HOSTS=api.ghidiem.online,ghidiem.online,www.ghidiem.online

# CORS: origins of the FE on Vercel
CORS_ALLOWED_ORIGINS=https://www.ghidiem.online,https://ghidiem.online

# Postgres (use a strong password — the db is not exposed, but still)
POSTGRES_DB=ghidiem
POSTGRES_USER=ghidiem
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis channel layer
REDIS_URL=redis://redis:6379/0

# Admin seed password — set BEFORE the first migrate (the migration seeds the user only once)
ADMIN_SEED_PASSWORD=change-me

# Number of uvicorn workers (Redis channel layer keeps broadcasts correct across workers)
UVICORN_WORKERS=2
