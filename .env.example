# Django
DJANGO_SECRET_KEY=dev-insecure-secret-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# CORS + WebSocket origin (Vite dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Postgres (used by docker compose; leave POSTGRES_HOST unset locally to use sqlite)
POSTGRES_DB=ghidiem
POSTGRES_USER=ghidiem
POSTGRES_PASSWORD=ghidiem
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis channel layer
REDIS_URL=redis://redis:6379/0
ADMIN_SEED_PASSWORD=1  # initial admin seed password (change for production)
